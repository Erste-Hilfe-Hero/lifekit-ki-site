# Optional: in .env kopieren und anpassen. Kein öffentlicher Server wird angelegt.
# Umgebungsvariablen haben Vorrang. --lan schaltet ausdrücklich auf 0.0.0.0.
HOST=127.0.0.1
PORT=3000
DATA_PATH=.data/nyrathen.sqlite
BACKUP_SECONDS=900
BACKUP_RETAIN=8
BACKUP_DIRECTORY=.data/backups
# Nur nach Einrichtung einer eigenen Domain/HTTPS:
# PUBLIC_URL=https://dein-spiel.example
# ALLOWED_ORIGINS=https://app.nyrathen.local,nyrathen://app
# Kein pauschales Vertrauen in X-Real-IP. Nur den eigenen Proxy explizit nennen.
# TRUSTED_PROXY_IPS=127.0.0.1

# Realtime network snapshots; simulation remains 20 Hz. Use 5 for high-density production workers.
SNAPSHOT_HZ=10

# Production legal identity (required before public legal pages return HTTP 200)
# NYRATHEN_PUBLISHER_NAME=Exact legal publisher or company name
# NYRATHEN_PUBLISHER_EMAIL=support@example.com
# NYRATHEN_PUBLISHER_POSTAL_ADDRESS=Street, postal code, city, country
# NYRATHEN_PRIVACY_CONTACT=privacy@example.com
# NYRATHEN_LEGAL_EFFECTIVE_DATE=2026-09-24
# NYRATHEN_SERVER_OPERATOR=Exact legal server operator name
