# Nyrathen v5.4 production configuration. Never commit the real .env.
# Public API host, e.g. api.nyrathen.example
NYRATHEN_DOMAIN=api.example.invalid
ACME_EMAIL=ops@example.invalid

# Generate independent secrets, e.g. openssl rand -base64 36
METRICS_TOKEN=REPLACE_WITH_RANDOM_SECRET
LIVEOPS_SIGNING_SECRET=REPLACE_WITH_RANDOM_SECRET
CLUSTER_SHARED_SECRET=REPLACE_WITH_RANDOM_SECRET
RESUME_TICKET_SECRET=REPLACE_WITH_RANDOM_SECRET

# Capacity model verified in v5.4: 100 nominal / 80 safe active players per worker,
# max 3 game workers per logical node, one spare worker in each target plan.
EXPECTED_CONCURRENT_PLAYERS=1000
GAME_WORKERS=14
LOGICAL_NODES=5
DEPLOYMENT_MODE=multi-node
SNAPSHOT_HZ=5
READY_TICK_P99_MS=180
MAX_SESSIONS=100
READY_SESSION_PERCENT=80
MAX_SSE_BACKLOG_BYTES=262144

# Backups / recovery / alerts. Off-site must be a genuinely separate failure domain.
BACKUP_SECONDS=900
BACKUP_RETAIN=32
BACKUP_TARGET=/secure-primary/nyrathen
OFFSITE_BACKUP_TARGET=s3://separate-offsite/nyrathen
ALERT_TARGET=ops-oncall

# Set only when an upstream proxy supplies X-Forwarded-For and its container/IP is trusted.
TRUSTED_PROXY_IPS=

# Optional publisher integrations; their credentials become mandatory when enabled.
NYRATHEN_COMMERCE=off
NYRATHEN_PUSH=off

# State backend safety. local-sqlite is allowed only for single-node operation.
# Multi-node capacity requires a publisher-operated, tested shared account/state backend.
STATE_BACKEND_MODE=external-certified
DISTRIBUTED_STATE_EVIDENCE=REPLACE_WITH_CHANGE_TICKET_OR_CERTIFICATION_ID
